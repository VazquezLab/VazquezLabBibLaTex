@ARTICLE{Belles2018-fz,
  title     = {Survival, opportunism ano convenience in the processes of cave
               colonization by terrestrial faunas},
  author    = {Bellés, Xavier},
  publisher = {Universitat de Barcelona},
  date      = {2018},
  abstract  = {Catalan; Valencian. Modero discoveries of cave-restricted animals
               in many tropical limestone areas, in lava tubes and other
               noncalcareous caves, and in subterranean non-cave habitats, have
               led us to reconsider classic interpretations of cave colonization
               processes, which were mainly based on the direct influence of
