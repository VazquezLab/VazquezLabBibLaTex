@ARTICLE{Rietbergen2023-tc,
  title        = {The Oldest Known Bat Skeletons and Their Implications for
                  {{Eocene}} Chiropteran Diversification},
  author       = {Rietbergen, Tim B and Ostende, Lars W van den Hoek and Aase,
                  Arvid and Jones, Matthew F and Medeiros, Edward D and Simmons,
