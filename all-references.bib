  date         = {2015-12},
  doi          = {10.1017/s1755691016000177},
  abstract     = {ABSTRACTPilosa include anteaters (Vermilingua) and sloths
                  (Folivora). Modern tree sloths are represented by two
                  genera,BradypusandCholoepus(both around 4–6 kg), whereas the
