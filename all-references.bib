  date         = {2017},
  doi          = {10.1002/ece3.2772},
  abstract     = {Understanding the winter behavior of bats in temperate North
                  America can provide insight into how bats react to
                  perturbations caused by natural disturbances such as weather,
                  human-induced disturbances, or the introduction of disease.
                  This study measured the activity patterns of bats outside of
                  their hibernaculum and asked how this winter activity varied
                  by time, temperature, bat species, body condition, and WNS
