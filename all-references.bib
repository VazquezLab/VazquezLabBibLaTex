@ARTICLE{Lovegrove2013-da,
  title        = {The Evolution of Mammal Body Sizes: Responses to {{Cenozoic}}
                  Climate Change in {{North American}} Mammals},
  shorttitle   = {The Evolution of Mammal Body Sizes},
  author       = {Lovegrove, B G and Mowoe, M O},
