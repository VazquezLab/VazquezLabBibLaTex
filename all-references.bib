@INBOOK{Fair2023-ih,
  title     = {Chapter 3.2.5 - Environmental endocrine-disrupting chemicals and
               their effects in marine mammals},
  author    = {Fair, Patricia A and Houde, Magali},
  editor    = {Carnevali, Oliana and Hardiman, Gary},
  booktitle = {Environmental Contaminants and Endocrine Health},
  publisher = {Academic Press},
  pages     = {283--306},
  date      = {2023-01-01},
  doi       = {10.1016/B978-0-12-824464-7.00017-9},
  abstract  = {The release of endocrine-disrupting chemicals (EDCs) in the
               environment has resulted in their wide distribution in aquatic
               and marine ecosystems. Wildlife is exposed to a wide variety of
               EDCs that can accumulate in body tissues and affect organism
               health. Numerous studies have focused on EDCs and their potential
               effects on marine mammals related to several important aspects
               (e.g., reproduction, thyroid hormone, vitamin A, adrenal gland,
               immune function, disease prevalence, and neoplasia) with a focus
               on pinnipeds, cetaceans, and polar bears. While not an exhaustive
               representation of all information that may exist in the
               scientific literature, we provide a review and summary of the
               knowledge on EDCs found in marine mammals and related effects in
               these organisms investigated in field studies, controlled feeding
               trials and in vitro studies.},
  keywords  = {Anthropogenic chemicals; Environmental exposure; Endocrine
               systems; Bioaccumulation; Health effects}
}

@ARTICLE{Desforges2018-tv,
  title        = {Predicting global killer whale population collapse from {PCB}
                  pollution},
  author       = {Desforges, Jean-Pierre and Hall, Ailsa and McConnell, Bernie
                  and Rosing-Asvid, Aqqalu and Barber, Jonathan L and Brownlow,
                  Andrew and De Guise, Sylvain and Eulaers, Igor and Jepson,
                  Paul D and Letcher, Robert J and Levin, Milton and Ross, Peter
                  S and Samarra, Filipa and Víkingson, Gísli and Sonne,
                  Christian and Dietz, Rune},
  journaltitle = {Science},
  volume       = {361},
  issue        = {6409},
  pages        = {1373--1376},
  date         = {2018-09-28},
  doi          = {10.1126/science.aat1953},
  abstract     = {Killer whales (Orcinus orca) are among the most highly
                  polychlorinated biphenyl (PCB)-contaminated mammals in the
                  world, raising concern about the health consequences of
                  current PCB exposures. Using an individual-based model
                  framework and globally available data on PCB concentrations in
                  killer whale tissues, we show that PCB-mediated effects on
                  reproduction and immune function threaten the long-term
                  viability of >50\% of the world's killer whale populations.
                  PCB-mediated effects over the coming 100 years predicted that
                  killer whale populations near industrialized regions, and
                  those feeding at high trophic levels regardless of location,
                  are at high risk of population collapse. Despite a near-global
                  ban of PCBs more than 30 years ago, the world's killer whales
                  illustrate the troubling persistence of this chemical class.},
  language     = {en}
}

@ARTICLE{Naidu2021-oh,
  title        = {Characterization of plastic debris from surface waters of the
                  eastern Arabian Sea-Indian Ocean},
  author       = {Naidu, S A and Mawii, L and Ranga Rao, V and Anitha, G and
                  Mishra, P and Narayanaswamy, Bhavani E and Anil Kumar, V and
                  Ramana Murthy, M V and Gvm, Gupta},
  journaltitle = {Marine pollution bulletin},
  volume       = {169},
  pages        = {112468},
  date         = {2021-08},
  doi          = {10.1016/j.marpolbul.2021.112468},
  abstract     = {The quantity of floating plastic debris (FPD) is continuously
                  being increased in the oceans. To assess their size,
                  structure, and composition along the eastern Arabian Sea
                  (EAS), FPD samples were collected by using a surface plankton
                  net. The microplastic size fraction (0.5-5 mm) was the most
                  prevalent accounting for >50\% of the total, followed by
                  mesoplastics (5-25 mm; ~40\%) and macroplastics (>25 mm;
                  ~10\%). The collected FPDs were categorized into five
                  different types and eight colours. Attenuated Total
                  Reflectance-Fourier Transform Infrared Spectrometry (ATR-FTIR)
                  analysis of the plastics revealed that polypropylene,
                  polyethylene, and nylon were the most dominant polymers, and
                  these comprised mostly of fibre/fishing line. The abundance of
                  FPD in the EAS (0.013 ± 0.012 no.s/m3) was found to be very
                  low compared to elsewhere. The prevalent microplastics
                  presence in the oceans might have occurred mainly by the
                  degradation of larger items. It increases bioavailability, and
                  hence, is a risk to marine ecosystems.},
  keywords     = {ATR-FTIR; Macroplastics; Mesoplastics; Microplastics; Plastic
                  pollution; SEM analysis},
  language     = {en}
}

