  date         = {2022-06},
  doi          = {10.1002/jcsm.13003},
  abstract     = {BACKGROUND: Aging-associated frailty has been connected to
                  low-grade chronic inflammation and also to progressive
                  monocytic activation. CD36 (cluster of differentiation 36,
                  platelet glycoprotein 4 or fatty acid translocase) has been
                  shown to induce the expression of pro-inflammatory cytokines
