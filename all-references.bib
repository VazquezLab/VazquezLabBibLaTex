@ARTICLE{Smith2015-mc,
  title        = {Less is more: an adaptive branch-site random effects model for
                  efficient detection of episodic diversifying selection},
  author       = {Smith, Martin D and Wertheim, Joel O and Weaver, Steven and
                  Murrell, Ben and Scheffler, Konrad and Kosakovsky Pond, Sergei
                  L},
  journaltitle = {Molecular biology and evolution},
  publisher    = {Oxford University Press (OUP)},
  volume       = {32},
  issue        = {5},
  pages        = {1342--1353},
  date         = {2015-05},
  doi          = {10.1093/molbev/msv022},
  abstract     = {Over the past two decades, comparative sequence analysis using
                  codon-substitution models has been honed into a powerful and
                  popular approach for detecting signatures of natural selection
                  from molecular data. A substantial body of work has focused on
                  developing a class of "branch-site" models which permit
                  selective pressures on sequences, quantified by the ω ratio,
                  to vary among both codon sites and individual branches in the
                  phylogeny. We develop and present a method in this class,
                  adaptive branch-site random effects likelihood (aBSREL), whose
