@ARTICLE{Dohmen2020-ni,
  title        = {{AMPK}-dependent activation of the Cyclin {Y}/{CDK16} complex
                  controls autophagy},
  author       = {Dohmen, Marc and Krieg, Sarah and Agalaridis, Georgios and
                  Zhu, Xiaoqing and Shehata, Saifeldin N and Pfeiffenberger,
                  Elisabeth and Amelang, Jan and Bütepage, Mareike and Buerova,
                  Elena and Pfaff, Carolina M and Chanda, Dipanjan and Geley,
                  Stephan and Preisinger, Christian and Sakamoto, Kei and
