@ARTICLE{Roman2010-qt,
  title        = {The whale pump: marine mammals enhance primary productivity in
                  a coastal basin},
  author       = {Roman, Joe and McCarthy, James J},
  journaltitle = {PloS one},
  volume       = {5},
  issue        = {10},
  pages        = {e13255},
  date         = {2010-10-11},
  doi          = {10.1371/journal.pone.0013255},
  abstract     = {It is well known that microbes, zooplankton, and fish are
                  important sources of recycled nitrogen in coastal waters, yet
                  marine mammals have largely been ignored or dismissed in this
                  cycle. Using field measurements and population data, we find
                  that marine mammals can enhance primary productivity in their
                  feeding areas by concentrating nitrogen near the surface
                  through the release of flocculent fecal plumes. Whales and
                  seals may be responsible for replenishing 2.3×10(4) metric
                  tons of N per year in the Gulf of Maine's euphotic zone, more
                  than the input of all rivers combined. This upward "whale
                  pump" played a much larger role before commercial harvest,
                  when marine mammal recycling of nitrogen was likely more than
                  three times atmospheric N input. Even with reduced
                  populations, marine mammals provide an important ecosystem
                  service by sustaining productivity in regions where they occur
                  in high densities.},
  language     = {en}
}

