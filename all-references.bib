@ARTICLE{Logsdon2024-yq,
  title        = {The variation and evolution of complete human centromeres},
  author       = {Logsdon, Glennis A and Rozanski, Allison N and Ryabov, Fedor
                  and Potapova, Tamara and Shepelev, Valery A and Catacchio,
                  Claudia R and Porubsky, David and Mao, Yafei and Yoo, Dongahn
                  and Rautiainen, Mikko and Koren, Sergey and Nurk, Sergey and
                  Lucas, Julian K and Hoekzema, Kendra and Munson, Katherine M
                  and Gerton, Jennifer L and Phillippy, Adam M and Ventura,
