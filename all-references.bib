@ARTICLE{Kang2018-ap,
  title        = {Multiplexed Droplet Single-Cell {{RNA-sequencing}} Using
                  Natural Genetic Variation},
  author       = {Kang, Hyun Min and Subramaniam, Meena and Targ, Sasha and
                  Nguyen, Michelle and Maliskova, Lenka and McCarthy, Elizabeth
