@ARTICLE{Mani2013-bh,
  title        = {Untangling the web: the diverse functions of the
                  {PIWI}/{piRNA} pathway: Functions of {thePIWI}/{piRNA} Pathway},
  author       = {Mani, Sneha Ramesh and Juliano, Celina E},
