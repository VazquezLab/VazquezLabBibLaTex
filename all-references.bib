  journaltitle = {Lung cancer (Amsterdam, Netherlands)},
  publisher    = {Elsevier BV},
  volume       = {135},
  pages        = {10--15},
  date         = {2019-09},
  doi          = {10.1016/j.lungcan.2019.07.003},
  abstract     = {OBJECTIVES: To analyze the relationship of GSTT1, GSTM1, XRCC1
                  (rs25487), ERCC1 (rs11615, rs3212986), ERCC2 (rs13181), XRCC3
                  (rs861539), OGG1 (rs1052133), and Alpha-1-Antitrypsin
