@ARTICLE{Eckalbar2016-rc,
  title        = {Transcriptomic and Epigenomic Characterization of the
                  Developing Bat Wing},
  author       = {Eckalbar, Walter L and Schlebusch, Stephen A and Mason, Mandy
                  K and Gill, Zoe and Parker, Ash V and Booker, Betty M and
                  Nishizaki, Sierra and Muswamba-Nday, Christiane and Terhune,
