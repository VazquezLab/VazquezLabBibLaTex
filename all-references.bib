@ARTICLE{Kampmann2018-my,
  title        = {{{CRISPRi}} and {{CRISPRa}} Screens in Mammalian Cells for
                  Precision Biology and Medicine},
  author       = {Kampmann, Martin},
  journaltitle = {ACS chemical biology},
