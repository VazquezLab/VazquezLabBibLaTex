@ARTICLE{Dutz2023-iu,
  title       = {Representation and Hesitancy in Population Health Research:
                 Evidence from a {COVID}-19 Antibody Study},
  author      = {Dutz, Deniz and Greenstone, Michael and Hortaçsu, Ali and
                 Lacouture, Santiago and Mogstad, Magne and Shaikh, Azeem M and
