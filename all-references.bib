  publisher    = {Cold Spring Harbor Laboratory},
  pages        = {2020.09.04.283655},
  date         = {2021-01},
  doi          = {10.1101/2020.09.04.283655},
  abstract     = {$$Exceptionally long-lived species, including many bats,
                  rarely show overt signs of aging, making it difficult to
                  determine why species differ in lifespan. Here, we use DNA
                  methylation (DNAm) profiles from 712 known-age bats,
                  representing 26 species, to identify epigenetic changes
