  author       = {Vazquez, Juan Manuel and Khudyakov, Jane I and Madelaire,
                  Carla B and Godard-Codding, Céline A and Routti, Heli and Lam,
                  Emily K and Piotrowski, Elizabeth R and Merrill, Greg B and
