@ARTICLE{Del-Rio2022-dw,
  title        = {Displaced clines in an avian hybrid zone (Thamnophilidae:
                  Rhegmatorhina) within an Amazonian interfluve},
  author       = {Del-Rio, Glaucia and Rego, Marco A and Whitney, Bret M and
                  Schunck, Fabio and Silveira, Luís F and Faircloth, Brant C and
                  Brumfield, Robb T},
  journaltitle = {Evolution; international journal of organic evolution},
  publisher    = {Oxford University Press (OUP)},
  volume       = {76},
  issue        = {3},
  pages        = {455--475},
  date         = {2022-03-01},
  doi          = {10.1111/evo.14377},
  abstract     = {Secondary contact between species often results in the
                  formation of a hybrid zone, with the eventual fates of the
                  hybridizing species dependent on evolutionary and ecological
                  forces. We examine this process in the Amazon Basin by
                  conducting the first genomic and phenotypic characterization
                  of the hybrid zone formed after secondary contact between two
                  obligate army-ant-followers: the White-breasted Antbird
                  (Rhegmatorhina hoffmannsi) and the Harlequin Antbird
                  (Rhegmatorhina berlepschi). We found a major geographic
                  displacement (∼120 km) between the mitochondrial and nuclear
                  clines, and we explore potential hypotheses for the
                  displacement, including sampling error, genetic drift, and
                  asymmetric cytonuclear incompatibilities. We cannot exclude
