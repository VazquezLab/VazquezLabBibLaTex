  language     = {en}
}

@ARTICLE{Wang2018-hw,
  title        = {Basic fibroblast growth factor protects against influenza A
                  virus-induced acute lung injury by recruiting neutrophils},
  author       = {Wang, Keyu and Lai, Chengcai and Li, Tieling and Wang, Cheng
