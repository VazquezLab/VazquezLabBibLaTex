@ARTICLE{De_Sotero-Caio2017-si,
  title        = {Centromeric enrichment of {LINE}-1 retrotransposons and its
                  significance for the chromosome evolution of Phyllostomid bats},
  author       = {de Sotero-Caio, Cibele Gomes and Cabral-de-Mello, Diogo
