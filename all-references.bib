  date         = {2024-02-14},
  doi          = {10.1016/j.xgen.2023.100482},
  abstract     = {The emergence of COVID-19 and severe acute respiratory
                  syndrome (SARS) has prioritized understanding bats' viral
                  tolerance. Myotis bats are exceptionally species rich and have
                  evolved viral tolerance. They also exhibit swarming, a cryptic
                  behavior where large, multi-species assemblages gather for
